# NEVER commit a real .env. chmod 600 .env on the VPS.
# Hyperliquid uses wallet private key (hex, no 0x prefix needed; bot accepts both).
HYPERLIQUID_ENABLED=true
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_TESTNET=false
# Aster uses classic API key/secret.
ASTER_ENABLED=false
ASTER_API_KEY=
ASTER_API_SECRET=
ASTER_TESTNET=
# Binance USD-M Futures (USDT-M Perps)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Global mode: paper | live  (always start with paper)
BOT_MODE=paper
# Dashboard login (hash only, generate via: python -m gg_bot dashboard-hash-password)
# DASHBOARD_PASSWORD_HASH=
